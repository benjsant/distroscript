# Logs d'installation
*.log

# Fichiers temporaires
*.tmp
*.bak

# macOS
.DS_Store

# Éditeurs
.vscode/
.idea/
*.swp
*.swo

# Manifestes distrobox-assemble générés (valeurs propres à une machine).
# Volontairement restreint : un `*.ini` global masquerait aussi un exemple de
# manifeste qu'on voudrait versionner.
/distrobox.ini
/assemble/*.ini
# Un exemple de manifeste reste versionnable malgré la règle ci-dessus.
!/assemble/exemple.ini
